# Copy to .env and fill in the empty values: cp .env.example .env

POSTGRES_DB=fitpulse
POSTGRES_USER=fitpulse
POSTGRES_PASSWORD=

# At least 32 characters. Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Port on your machine where the app is served (http://localhost:8081)
APP_PORT=8081

# Optional: first admin account, created on startup if it doesn't exist (password min 8 chars)
ADMIN_MAIL=
ADMIN_PASSWORD=

# Optional: real SMTP server. By default mail goes to Mailpit (http://localhost:8025).
# Uncomment only if you use one; empty values would override the defaults.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=app-password
# MAIL_FROM=FitPulse <you@gmail.com>
